module esp32c3;

constdef Pin {
PIN0 = 0,
PIN1 = 1,
PIN2 = 2,
PIN3 = 3,
PIN4 = 4,
PIN5 = 5,
PIN6 = 6,
PIN7 = 7,
PIN8 = 8,
PIN9 = 9,
PIN10 = 10,
PIN18 = 18,
PIN19 = 19,
PIN20 = 20,
PIN21 = 21,
}

macro void pin_out(Pin pin)
	=> pin_out_impl(pin);

macro void pin_on(Pin pin)
	=> pin_on_impl(pin);

macro void pin_off(Pin pin)
	=> pin_off_impl(pin);

macro void pin_in(Pin pin)
	=> pin_in_impl(pin);

macro void pin_in_pullup(Pin pin)
	=> pin_in_pullup_impl(pin);

macro void pin_in_pulldown(Pin pin)
	=> pin_in_pulldown_impl(pin);

macro bool pin_read(Pin pin)
	=> pin_read_impl(pin);

macro void uart_print(char* text)
	=> uart_write_impl(text);

macro void uart_printn(char* text)
	=> uart_write_line_impl(text);

macro void delay_us(uint us)
	=> delay_us_impl(us);

macro void delay_ms(uint ms)
	=> delay_ms_impl(ms);
