module esp32c3;

import esp32c3::hal::uart;

macro void print(value)
	=> uart::print(value);

macro void printn(value)
	=> uart::printn(value);

macro void printf(char* fmt, args...)
	=> uart::printf(fmt, args);

macro void printfn(char* fmt, args...)
	=> uart::printfn(fmt, args);

macro void flush()
	=> uart::flush();

macro void delay_us(uint us)
	=> delay_us_impl(us);

macro void delay_ms(uint ms)
	=> delay_ms_impl(ms);
